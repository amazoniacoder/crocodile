{
  "name": "news-aggregator",
  "version": "2.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "dev:client": "wait-on http://localhost:5000/api/health/live --timeout 30000 && vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "clean": "rimraf node_modules/.vite client/node_modules/.vite dist client/dist",
    "clean:cache": "rimraf node_modules/.vite client/node_modules/.vite",
    "test:server": "vitest run --config vitest.config.server.ts",
    "test:client": "vitest run --config client/vitest.config.ts",
    "test": "npm run test:server && npm run test:client"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.24",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dexie": "^4.4.2",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.39.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-ws": "^5.0.2",
    "geoip-lite": "^1.4.10",
    "http-proxy-middleware": "^3.0.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "redis": "^5.1.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.3",
    "ua-parser-js": "^2.0.9",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "wouter": "^3.3.5",
    "ws": "^8.18.2",
    "xml2js": "^0.4.23",
    "zod": "^3.24.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.16.11",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.18.1",
