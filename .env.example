# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (Unified)
# Option 1: Full connection string (recommended)
DATABASE_URL=postgres://user:password@localhost:5432/blogpro?sslmode=disable&max_connections=20&timeout=30

# Option 2: Individual variables (for compatibility)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=blogpro
# DB_SSL=false
# DB_MAX_CONNECTIONS=20
# DB_TIMEOUT=30

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379

# Admin API (для управления источниками новостей)
ADMIN_TOKEN=your-admin-secret-token

# NER-микросервис (Entity-Driven Cluster)
NER_SERVICE_URL=http://ner-service:8001
NER_BATCH_SIZE=10
NER_TIMEOUT_MS=5000

# Tracing and Monitoring
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SERVICE_NAME=news-aggregator
SERVICE_VERSION=1.9.0

# Security
IP_WHITELIST=127.0.0.1,::1
FRONTEND_URL=http://localhost:3000

# Security Monitoring
DOMAIN=localhost
ALERT_WEBHOOK_URL=

# Rate Limiting
MAX_RATE_LIMITERS=1000

# SSL Configuration
SSL_ENABLED=false

# Web Push (VAPID)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Минимальное число новых статей для отправки push (default: 5)
PUSH_THRESHOLD=5

# SMTP Configuration (for contact form)
# Gmail example: smtp.gmail.com, port 587
# Use App Password for Gmail (not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="BlogPro Contact" <noreply@blogpro.com>
CONTACT_EMAIL=rockbandbugs@gmail.com

# RSSHub Configuration (for Telegram channels)
RSSHUB_URL=http://localhost:1200

# Telegram Subscription
TELEGRAM_TOKEN_LENGTH=32
TELEGRAM_DEFAULT_EXPIRY_DAYS=30